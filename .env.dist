OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PINECONE_API_KEY=

# Optional. Defaults are the values required by the spec.
# LLM_PROVIDER=openai
# TOP_K=4
# HYBRID_K=5
# SCORE_THRESHOLD=0
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50
# EMBEDDING_PROVIDER=openai
# HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# COLLECTION_NAME=techcorp_policies
# VECTORSTORE_DIR=vectorstore
# DATA_DIR=data

# Pinecone. The index dimension follows the configured embedding model
# (1536 for the default OpenAI text-embedding-3-small, 384 for the Hugging Face model).
# VECTOR_STORE=pinecone
# INDEX_NAME=delivery4-index
# NAMESPACE=delivery4
# EMBEDDING_BATCH_SIZE=100
# EMBEDDING_DIMENSION=1536
